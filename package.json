{
  "name": "@seike460/minamo",
  "version": "0.2.0",
  "description": "Type-safe CQRS+ES for AWS Serverless",
  "keywords": [
    "cqrs",
    "event-sourcing",
    "event-store",
    "dynamodb",
    "aws",
    "serverless",
    "lambda",
    "typescript",
    "esm"
  ],
  "author": {
    "name": "Shiro Seike",
    "url": "https://github.com/seike460"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seike460/minamo.git"
  },
  "homepage": "https://github.com/seike460/minamo#readme",
  "bugs": {
    "url": "https://github.com/seike460/minamo/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "tsdown && tsc --declaration --emitDeclarationOnly --outDir dist",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "lint": "biome check .",
    "format": "biome check --write .",
    "ci": "biome ci .",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "check-exports": "attw --pack . --profile esm-only && publint .",
    "check-instanceof": "node scripts/verify-instanceof.mjs",
    "check-optional-peer": "node scripts/verify-optional-peer.mjs",
    "check-api": "api-extractor run",
    "api-report": "api-extractor run --local",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@aws-sdk/client-dynamodb": "^3.1135.0",
    "@aws-sdk/lib-dynamodb": "^3.1135.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@biomejs/biome": "^2.5.14",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@microsoft/api-extractor": "^7.59.1",
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "^4.1.11",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@aws-sdk/util-dynamodb": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/lib-dynamodb": {
      "optional": true
    },
    "@aws-sdk/util-dynamodb": {
      "optional": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "brace-expansion@^2.0.1": ">=2.1.4",
      "brace-expansion@^5.0.1": ">=5.0.9",
      "fast-uri": ">=3.1.6",
      "js-yaml@^3.6.1": "^3.15.2",
      "js-yaml@^4.0.0": ">=4.3.2",
      "js-yaml@^4.1.0": ">=4.3.2",
      "nanoid@^3": ">=3.3.18",
      "postcss": ">=8.5.23",
      "vite@^7": ">=7.3.5",
      "esbuild": ">=0.28.1"
    }
  }
}
